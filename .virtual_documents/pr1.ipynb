# 3.1 Elbow Method
k_range = list(range(1,11))
inertias = [KMeans(n_clusters=k,random_state=R_S,n_init=10).fit(df_2f).inertia_ for k in k_range]
elbow=KneeLocator(k_range,inertias,curve="convex",direction="decreasing").elbow

plt.figure(figsize=(8,5))
plt.plot(k_range,inertias,marker="o",color=RED,linewidth=2,label="Inertia")
plt.axvline(elbow,color='black',linestyle='--',label=f"Elbow at k = {elbow}")
plt.scatter([elbow],[inertias[elbow-1]],s=200,facecolors='none',edgecolors='black',linewidths=2)
plt.title("Elbow Method - Optimal k for K-Means")
plt.xlabel("Number of clusters(k)")
plt.ylabel("Inertia (Within-cluster sum of Squares)")
plt.xticks(k_range)
plt.legend()
save_fig("05_elbow_method")
plt.show()
pd.DataFrame({"k":k_range,"Inertia":np.round(inertias,2)}).T





# 3.2 Silhouette Score
sil_k_range = list(range(2,11))
sil_scores= [silhouette_score(df_2f,KMeans(n_clusters=k,random_state=R_S,n_init=10).fit_predict(df_2f)) for k in sil_k_range]
best_k = sil_k_range[int(np.argmax(sil_scores))]

plt.figure(figsize=(8,5))
plt.plot(sil_k_range,sil_scores,marker="o",color=RED,linewidth=2,label="Silhouette score")
plt.axvline(best_k,color='black',linestyle='--',label=f"Best k = {best_k}")
plt.title("Silhouette Score vs Numer of Clusters")
plt.xlabel("Number of clusters (k)")
plt.ylabel("Average silhouette score")
plt.xticks(sil_k_range)
plt.legend()
save_fig("06_silhouette score")
plt.show()
print(pd.Series(np.round(sil_scores,4),index=pd.Index(sil_k_range,name='k'),name="Silhouette"))
print(f"Elbow choice: k {elbow} | Silhouette choice: k = {best_k}")





# 3.3 Fit the final K-Means model
k_final = best_k
kmeans = KMeans(n_clusters=k_final,random_state=R_S,n_init=10).fit(df_2f)
