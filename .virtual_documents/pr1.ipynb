# 6.1 Three-panel comparison figure
# DBSCAN clusters inherit the colour of the K-Means cluster they overlap most
db_overlap = pd.crosstab(df.loc[core, 'DBSCAN_Cluster'], df.loc[core, 'KMeans_Cluster'])
r, c = linear_sum_assignment(-db_overlap.values)
db_colors = {db_overlap.index[i]: k_colors[db_overlap.columns[j]] for i, j in zip(r, c)}

fig, axes = plt.subplots(1, 3, figsize=(18, 5), sharex=True, sharey=True)
panels = [('KMeans_Cluster', 'K-Means', k_colors),
          ('Hier_Cluster', 'Hierarchical (Ward)', k_colors),
          ('DBSCAN_Cluster', 'DBSCAN', db_colors)]
for ax, (col, title, colors) in zip(axes, panels):
    for lab in sorted(df[col].unique()):
        m = df[col] == lab
        if lab == -1:
            ax.scatter(df.loc[m, 'Annual_Income'], df.loc[m, 'Spending_Score'],
                       c='black', marker='x', s=45, label='Noise')
        else:
            ax.scatter(df.loc[m, 'Annual_Income'], df.loc[m, 'Spending_Score'], color=colors[lab],
                       s=50, edgecolor='white', linewidth=0.5, label=f'Cluster {lab}')
    ax.set_title(title)
    ax.set_xlabel('Annual Income (k$)')
    ax.set_ylabel('Spending Score (1-100)')
    ax.legend(loc='upper center', bbox_to_anchor=(0.5, -0.17), ncol=3, fontsize=9)
fig.suptitle('Clustering Algorithm Comparison — Mall Customer Segmentation',
             color=RED, fontweight='bold', fontsize=16, y=1.03)
plt.tight_layout()
save_fig('13_three_panel_comparison')
plt.show()


def evaluate(name, data, labels):
    mask = labels != -1
    return {'Algorithm': name,
            'n_clusters': len(set(labels[mask])),
            'Noise points': int((~mask).sum()),
            'Silhouette Score': silhouette_score(data[mask], labels[mask]),
            'Davies-Bouldin Index': davies_bouldin_score(data[mask], labels[mask]),
            'Calinski-Harabasz Index': calinski_harabasz_score(data[mask], labels[mask])}

metrics = pd.DataFrame([
    evaluate('K-Means', df_2f, df['KMeans_Cluster'].to_numpy()),
    evaluate('Agglomerative (Ward)', df_2f, df['Hier_Cluster'].to_numpy()),
    evaluate('DBSCAN (noise excluded)', df_2f, df['DBSCAN_Cluster'].to_numpy()),
]).set_index('Algorithm')

(metrics.style.format({'Silhouette Score': '{:.4f}', 'Davies-Bouldin Index': '{:.4f}',
                       'Calinski-Harabasz Index': '{:.2f}'})
 .highlight_max(subset=['Silhouette Score', 'Calinski-Harabasz Index'], color='#f8c9c9')
 .highlight_min(subset=['Davies-Bouldin Index'], color='#f8c9c9')
 .set_caption('Clustering metrics (higher Silhouette / Calinski-Harabasz and lower Davies-Bouldin are better)'))





